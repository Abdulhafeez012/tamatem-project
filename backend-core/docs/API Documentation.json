{"swagger": "2.0", "info": {"title": "Tamatem Online Market API", "description": "Tamatem assessment", "version": "v1"}, "host": "localhost:8000", "schemes": ["http"], "basePath": "/api/v1", "consumes": ["application/json"], "produces": ["application/json"], "securityDefinitions": {"Bearer": {"type": "apiKey", "name": "Authorization", "in": "header", "description": "JWT Authorization header using the Bearer scheme. Example: \"Bearer <your-access-token>\""}}, "security": [{"Bearer": []}], "paths": {"/auth/login/": {"post": {"operationId": "auth_login_create", "summary": "Login and get JWT tokens", "description": "Authenticates a user and returns JWT access and refresh tokens.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"required": ["username", "password"], "type": "object", "properties": {"username": {"type": "string", "example": "aboud"}, "password": {"type": "string", "format": "password", "example": "Str0ngPass!23"}}, "example": {"username": "aboud", "password": "Str0ngPass!23"}}}], "responses": {"200": {"description": "Login successful", "schema": {"required": ["access", "refresh", "user"], "type": "object", "properties": {"access": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access-token"}, "refresh": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token"}, "user": {"required": ["id", "username", "email"], "type": "object", "properties": {"id": {"type": "integer", "example": 1}, "username": {"type": "string", "example": "aboud"}, "email": {"type": "string", "format": "email", "example": "aboud@example.com"}}}}, "example": {"access": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access-token", "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token", "user": {"id": 1, "username": "aboud", "email": "aboud@example.com"}}}, "examples": {"application/json": {"access": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access-token", "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token", "user": {"id": 1, "username": "aboud", "email": "aboud@example.com"}}}}, "400": {"description": "Missing required fields", "schema": {"type": "object", "example": {"email": ["Enter a valid email address."], "confirm_password": ["Passwords do not match."]}}, "examples": {"application/json": {"password": ["This field is required."]}}}, "401": {"description": "Invalid credentials", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "No active account found with the given credentials"}}}}, "tags": ["Auth"], "security": []}, "parameters": []}, "/auth/login/refresh/": {"post": {"operationId": "auth_login_refresh_create", "summary": "Refresh an access token", "description": "Accepts a refresh token and returns a new JWT access token.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"required": ["refresh"], "type": "object", "properties": {"refresh": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token"}}, "example": {"refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token"}}}], "responses": {"200": {"description": "Token refreshed successfully", "schema": {"required": ["access", "refresh"], "type": "object", "properties": {"access": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.new-access-token"}, "refresh": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.rotated-refresh-token"}}, "example": {"access": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.new-access-token", "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.rotated-refresh-token"}}, "examples": {"application/json": {"access": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.new-access-token", "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.rotated-refresh-token"}}}, "401": {"description": "Invalid, expired or blacklisted refresh token", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Token is invalid or expired"}}}}, "tags": ["Auth"], "security": []}, "parameters": []}, "/auth/logout/": {"post": {"operationId": "auth_logout_create", "summary": "Log out and revoke a refresh token", "description": "Blacklists the supplied refresh token so it can no longer be exchanged for a new access token. Requires the access token of the same user the refresh token was issued to.\n\nThe access token itself is not revoked -- simplejwt's blacklist tracks refresh tokens only -- so it stays usable until it expires (at most 30 minutes). Revoking the refresh token is what stops the session being extended beyond that.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"required": ["refresh"], "type": "object", "properties": {"refresh": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token"}}, "example": {"refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token"}}}], "responses": {"204": {"description": "Refresh token revoked; no body returned"}, "400": {"description": "Missing, malformed, expired or already-revoked token", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Token is invalid or expired."}}}, "401": {"description": "Missing or invalid access token", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Authentication credentials were not provided."}}}, "403": {"description": "The refresh token belongs to a different user", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Token does not belong to the authenticated user."}}}}, "tags": ["Auth"], "security": [{"Bearer": []}]}, "parameters": []}, "/auth/signup/": {"post": {"operationId": "auth_signup_create", "summary": "Register a new user", "description": "Creates a user account and returns JWT access and refresh tokens.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"required": ["username", "email", "password", "confirm_password"], "type": "object", "properties": {"username": {"type": "string", "example": "aboud"}, "email": {"type": "string", "format": "email", "example": "aboud@example.com"}, "password": {"type": "string", "format": "password", "example": "Str0ngPass!23"}, "confirm_password": {"type": "string", "format": "password", "example": "Str0ngPass!23"}}, "example": {"username": "aboud", "email": "aboud@example.com", "password": "Str0ngPass!23", "confirm_password": "Str0ngPass!23"}}}], "responses": {"201": {"description": "User registered successfully", "schema": {"required": ["access", "refresh", "user"], "type": "object", "properties": {"access": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access-token"}, "refresh": {"type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token"}, "user": {"required": ["id", "username", "email"], "type": "object", "properties": {"id": {"type": "integer", "example": 1}, "username": {"type": "string", "example": "aboud"}, "email": {"type": "string", "format": "email", "example": "aboud@example.com"}}}}, "example": {"access": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access-token", "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token", "user": {"id": 1, "username": "aboud", "email": "aboud@example.com"}}}, "examples": {"application/json": {"access": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.access-token", "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.refresh-token", "user": {"id": 1, "username": "aboud", "email": "aboud@example.com"}}}}, "400": {"description": "Validation error", "schema": {"type": "object", "example": {"email": ["Enter a valid email address."], "confirm_password": ["Passwords do not match."]}}, "examples": {"application/json": {"confirm_password": ["Passwords do not match."]}}}, "409": {"description": "Duplicate user data detected", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "A user with these credentials already exists."}}}, "500": {"description": "Unexpected registration failure", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Could not complete registration. Please try again."}}}}, "tags": ["Auth"], "security": []}, "parameters": []}, "/orders/purchase/": {"post": {"operationId": "orders_purchase_create", "summary": "Purchase a product", "description": "Creates a new order for the authenticated user. The order quantity is currently fixed at 1, and the product's current price is saved as the unit and total price.\n\nAn `Idempotency-Key` header is **required**, which makes every purchase retry-safe by construction: a repeat with the same key returns `200` with the original order rather than creating a duplicate. A request without the header is rejected with `400`.", "parameters": [{"name": "data", "in": "body", "required": true, "schema": {"$ref": "#/definitions/PurchaseRequest"}}, {"name": "Idempotency-Key", "in": "header", "description": "**Required.** A unique value per purchase attempt -- a UUID is the obvious choice. Reuse the same value when retrying: the repeat returns the order the first call created (200, with an `Idempotent-Replay: true` header) instead of placing a second one. Keys are scoped per user and may be at most 255 characters. A new, intentional purchase needs a new key.", "required": true, "type": "string"}], "responses": {"200": {"description": "Replay: an order already exists for this Idempotency-Key, and is returned unchanged. Carries `Idempotent-Replay: true`.", "schema": {"required": ["order_number", "product", "quantity", "unit_price", "total_price", "status", "created_at"], "type": "object", "properties": {"order_number": {"type": "string", "format": "uuid", "example": "3f6b1a5e-9c42-4b7d-8e10-2a5f6c8d1b39"}, "product": {"required": ["id", "title", "description", "price", "location"], "type": "object", "properties": {"id": {"type": "integer", "example": 1}, "title": {"type": "string", "example": "PlayStation 5"}, "description": {"type": "string", "example": "Slim edition console with one controller."}, "price": {"type": "string", "example": "499.99"}, "location": {"type": "string", "enum": ["JO", "SA"], "example": "JO"}}}, "quantity": {"type": "integer", "example": 1}, "unit_price": {"type": "string", "example": "499.99"}, "total_price": {"type": "string", "example": "499.99"}, "status": {"type": "string", "example": "COMPLETED"}, "created_at": {"type": "string", "format": "date-time", "example": "2026-08-21T10:30:00Z"}}, "example": {"order_number": "3f6b1a5e-9c42-4b7d-8e10-2a5f6c8d1b39", "product": {"id": 1, "title": "PlayStation 5", "description": "Slim edition console with one controller.", "price": "499.99", "location": "JO"}, "quantity": 1, "unit_price": "499.99", "total_price": "499.99", "status": "COMPLETED", "created_at": "2026-08-21T10:30:00Z"}}}, "201": {"description": "Order created successfully", "schema": {"required": ["order_number", "product", "quantity", "unit_price", "total_price", "status", "created_at"], "type": "object", "properties": {"order_number": {"type": "string", "format": "uuid", "example": "3f6b1a5e-9c42-4b7d-8e10-2a5f6c8d1b39"}, "product": {"required": ["id", "title", "description", "price", "location"], "type": "object", "properties": {"id": {"type": "integer", "example": 1}, "title": {"type": "string", "example": "PlayStation 5"}, "description": {"type": "string", "example": "Slim edition console with one controller."}, "price": {"type": "string", "example": "499.99"}, "location": {"type": "string", "enum": ["JO", "SA"], "example": "JO"}}}, "quantity": {"type": "integer", "example": 1}, "unit_price": {"type": "string", "example": "499.99"}, "total_price": {"type": "string", "example": "499.99"}, "status": {"type": "string", "example": "COMPLETED"}, "created_at": {"type": "string", "format": "date-time", "example": "2026-08-21T10:30:00Z"}}, "example": {"order_number": "3f6b1a5e-9c42-4b7d-8e10-2a5f6c8d1b39", "product": {"id": 1, "title": "PlayStation 5", "description": "Slim edition console with one controller.", "price": "499.99", "location": "JO"}, "quantity": 1, "unit_price": "499.99", "total_price": "499.99", "status": "COMPLETED", "created_at": "2026-08-21T10:30:00Z"}}, "examples": {"application/json": {"order_number": "3f6b1a5e-9c42-4b7d-8e10-2a5f6c8d1b39", "product": {"id": 1, "title": "PlayStation 5", "description": "Slim edition console with one controller.", "price": "499.99", "location": "JO"}, "quantity": 1, "unit_price": "499.99", "total_price": "499.99", "status": "COMPLETED", "created_at": "2026-08-21T10:30:00Z"}}}, "400": {"description": "Invalid purchase request, or a missing / over-long Idempotency-Key header", "schema": {"type": "object", "properties": {"product_id": {"type": "array", "items": {"type": "string"}}}, "example": {"product_id": ["Product ID must be greater than or equal to 1."]}}, "examples": {"application/json": {"product_id": ["Product ID must be greater than or equal to 1."]}, "application/json (missing header)": {"detail": "Idempotency-Key header is required. Send a unique value per purchase attempt (a UUID is the obvious choice) and reuse it when retrying."}}}, "401": {"description": "Missing or invalid JWT token", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Authentication credentials were not provided."}}}, "404": {"description": "Product not found", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Product not found."}}}}, "tags": ["Orders"], "security": [{"Bearer": []}]}, "parameters": []}, "/orders/{order_number}/": {"get": {"operationId": "orders_read", "summary": "Retrieve an order receipt", "description": "Returns an order receipt by order number. Users can only retrieve their own orders.", "parameters": [{"name": "order_number", "in": "path", "description": "The order's UUID. The route uses a <uuid:...> converter, so a non-UUID value does not match the URL at all.", "required": true, "type": "string", "format": "uuid", "example": "3f6b1a5e-9c42-4b7d-8e10-2a5f6c8d1b39"}], "responses": {"200": {"description": "Order receipt fetched successfully", "schema": {"required": ["order_number", "product", "quantity", "unit_price", "total_price", "status", "created_at"], "type": "object", "properties": {"order_number": {"type": "string", "format": "uuid", "example": "3f6b1a5e-9c42-4b7d-8e10-2a5f6c8d1b39"}, "product": {"required": ["id", "title", "description", "price", "location"], "type": "object", "properties": {"id": {"type": "integer", "example": 1}, "title": {"type": "string", "example": "PlayStation 5"}, "description": {"type": "string", "example": "Slim edition console with one controller."}, "price": {"type": "string", "example": "499.99"}, "location": {"type": "string", "enum": ["JO", "SA"], "example": "JO"}}}, "quantity": {"type": "integer", "example": 1}, "unit_price": {"type": "string", "example": "499.99"}, "total_price": {"type": "string", "example": "499.99"}, "status": {"type": "string", "example": "COMPLETED"}, "created_at": {"type": "string", "format": "date-time", "example": "2026-08-21T10:30:00Z"}}, "example": {"order_number": "3f6b1a5e-9c42-4b7d-8e10-2a5f6c8d1b39", "product": {"id": 1, "title": "PlayStation 5", "description": "Slim edition console with one controller.", "price": "499.99", "location": "JO"}, "quantity": 1, "unit_price": "499.99", "total_price": "499.99", "status": "COMPLETED", "created_at": "2026-08-21T10:30:00Z"}}, "examples": {"application/json": {"order_number": "3f6b1a5e-9c42-4b7d-8e10-2a5f6c8d1b39", "product": {"id": 1, "title": "PlayStation 5", "description": "Slim edition console with one controller.", "price": "499.99", "location": "JO"}, "quantity": 1, "unit_price": "499.99", "total_price": "499.99", "status": "COMPLETED", "created_at": "2026-08-21T10:30:00Z"}}}, "401": {"description": "Missing or invalid JWT token", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Authentication credentials were not provided."}}}, "404": {"description": "Order not found", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Order Not Found."}}}}, "tags": ["Orders"], "security": [{"Bearer": []}]}, "parameters": [{"name": "order_number", "in": "path", "required": true, "type": "string"}]}, "/products/": {"get": {"operationId": "products_list", "summary": "List products", "description": "Returns a paginated list of products. Requires a valid JWT access token.", "parameters": [{"name": "location", "in": "query", "description": "Filter products by location.", "type": "string", "enum": ["JO", "SA"], "example": "JO"}, {"name": "page", "in": "query", "description": "Page number to retrieve.", "type": "integer", "example": 1}, {"name": "page_size", "in": "query", "description": "Number of products per page. Default is 10 and maximum is 20.", "type": "integer", "example": 10}], "responses": {"200": {"description": "Products fetched successfully", "schema": {"required": ["count", "next", "previous", "results"], "type": "object", "properties": {"count": {"type": "integer", "example": 2}, "next": {"type": "string", "format": "uri", "x-nullable": true}, "previous": {"type": "string", "format": "uri", "x-nullable": true}, "results": {"type": "array", "items": {"required": ["id", "title", "description", "price", "location"], "type": "object", "properties": {"id": {"type": "integer", "example": 1}, "title": {"type": "string", "example": "PlayStation 5"}, "description": {"type": "string", "example": "Slim edition console with one controller."}, "price": {"type": "string", "example": "499.99"}, "location": {"type": "string", "enum": ["JO", "SA"], "example": "JO"}}, "example": {"id": 1, "title": "PlayStation 5", "description": "Slim edition console with one controller.", "price": "499.99", "location": "JO"}}}}, "example": {"count": 2, "next": null, "previous": null, "results": [{"id": 1, "title": "PlayStation 5", "description": "Slim edition console with one controller.", "price": "499.99", "location": "JO"}, {"id": 2, "title": "Nintendo Switch OLED", "description": "White Joy-Con bundle in excellent condition.", "price": "329.00", "location": "SA"}]}}, "examples": {"application/json": {"count": 2, "next": null, "previous": null, "results": [{"id": 1, "title": "PlayStation 5", "description": "Slim edition console with one controller.", "price": "499.99", "location": "JO"}, {"id": 2, "title": "Nintendo Switch OLED", "description": "White Joy-Con bundle in excellent condition.", "price": "329.00", "location": "SA"}]}}}, "400": {"description": "Invalid query parameter", "schema": {"required": ["location"], "type": "object", "properties": {"location": {"type": "string"}}, "example": {"location": "Must be one of: JO, SA."}}, "examples": {"application/json": {"location": "Must be one of: JO, SA."}}}, "401": {"description": "Missing or invalid JWT token", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Authentication credentials were not provided."}}}}, "tags": ["Products"], "security": [{"Bearer": []}]}, "parameters": []}, "/products/{id}/": {"get": {"operationId": "products_read", "summary": "Retrieve a single product", "description": "Returns a single product by ID. Requires a valid JWT access token.", "parameters": [{"name": "pk", "in": "path", "description": "The product ID.", "required": true, "type": "integer", "example": 1}], "responses": {"200": {"description": "Product fetched successfully", "schema": {"$ref": "#/definitions/Product"}, "examples": {"application/json": {"id": 1, "title": "PlayStation 5", "description": "Slim edition console with one controller.", "price": "499.99", "location": "JO"}}}, "401": {"description": "Missing or invalid JWT token", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Authentication credentials were not provided."}}}, "404": {"description": "Product not found", "schema": {"required": ["detail"], "type": "object", "properties": {"detail": {"type": "string"}}}, "examples": {"application/json": {"detail": "Product not found."}}}}, "tags": ["Products"], "security": [{"Bearer": []}]}, "parameters": [{"name": "id", "in": "path", "description": "A unique integer value identifying this product.", "required": true, "type": "integer"}]}}, "definitions": {"PurchaseRequest": {"required": ["product_id"], "type": "object", "properties": {"product_id": {"title": "Product id", "type": "integer", "minimum": 1}}}, "Product": {"type": "object", "properties": {"id": {"title": "ID", "type": "integer", "readOnly": true}, "title": {"title": "Title", "type": "string", "readOnly": true, "minLength": 1}, "description": {"title": "Description", "type": "string", "readOnly": true, "minLength": 1}, "price": {"title": "Price", "type": "string", "format": "decimal", "readOnly": true}, "location": {"title": "Location", "type": "string", "enum": ["JO", "SA"], "readOnly": true}}}}}