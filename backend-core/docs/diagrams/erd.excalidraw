    {
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 3857431602,
      "version": 100,
      "versionNonce": 927297001,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755730800000,
      "link": null,
      "locked": false,
      "id": "ozYl0nGt",
      "type": "text",
      "width": 1040,
      "height": 65,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "PROTECT on both keys: an order must never end up without a buyer or an item, so the delete is refused rather than cascaded.\nunit_price and total_price are copied at purchase time, so editing a product later cannot rewrite what someone was charged.\norder_number is a UUID, which keeps receipt URLs unguessable — and the receipt queryset is scoped to request.user, so another user\ngets the same 404 as a stranger.",
      "originalText": "PROTECT on both keys: an order must never end up without a buyer or an item, so the delete is refused rather than cascaded.\nunit_price and total_price are copied at purchase time, so editing a product later cannot rewrite what someone was charged.\norder_number is a UUID, which keeps receipt URLs unguessable — and the receipt queryset is scoped to request.user, so another user\ngets the same 404 as a stranger.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "x": 60,
      "y": 645
    },
