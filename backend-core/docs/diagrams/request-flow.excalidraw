      "updated": 1787393585456,
      "link": null,
      "locked": false,
      "id": "hiToRGDu",
      "type": "text",
      "width": 738.8671875,
      "height": 32.5,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "The domain apps hold models only; every serializer, view, route, filter and paginator lives under\napi/v1/<domain>/. Adding /api/v2/ means a new package beside v1 — no model change.",
      "originalText": "The domain apps hold models only; every serializer, view, route, filter and paginator lives under\napi/v1/<domain>/. Adding /api/v2/ means a new package beside v1 — no model change.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "x": 60,
      "y": 1500
    },
    {
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 3722943287,
      "version": 101,
      "versionNonce": 826511933,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787393581223,
      "link": null,
      "locked": false,
      "id": "loh4laBY",
      "type": "text",
      "width": 340,
      "height": 113.75,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "The lock plus the atomic block make two\nsimultaneous purchases of the same product\nserialise. The Idempotency-Key makes a\nretry safe: a repeat returns the original\norder rather than placing a second one,\nenforced by a unique constraint so even a\nconcurrent retry cannot slip through.",
      "originalText": "The lock plus the atomic block make two\nsimultaneous purchases of the same product\nserialise. The Idempotency-Key makes a\nretry safe: a repeat returns the original\norder rather than placing a second one,\nenforced by a unique constraint so even a\nconcurrent retry cannot slip through.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "x": 500,
      "y": 1186
    }
  ],
