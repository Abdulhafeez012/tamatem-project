      "link": null,
      "locked": false,
      "id": "NodGr8jU",
      "type": "text",
      "width": 290,
      "height": 65,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "Written on sign-in, cleared on\nsign-out or a failed refresh. The\nstorage event propagates a sign-out\nto other tabs.",
      "originalText": "Written on sign-in, cleared on\nsign-out or a failed refresh. The\nstorage event propagates a sign-out\nto other tabs.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
