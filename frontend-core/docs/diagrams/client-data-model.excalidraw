      "updated": 1755730800000,
      "link": null,
      "locked": false,
      "id": "h0BQZWtS",
      "type": "text",
      "width": 1080,
      "height": 48.75,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "The frontend owns no database — this is its type and storage model. Prices stay strings all the way to the screen because that is how DRF\nserialises DecimalField, and parsing them into floats would introduce rounding the server never had. The API exposes no currency field, so\namounts render as plain numbers.",
      "originalText": "The frontend owns no database — this is its type and storage model. Prices stay strings all the way to the screen because that is how DRF\nserialises DecimalField, and parsing them into floats would introduce rounding the server never had. The API exposes no currency field, so\namounts render as plain numbers.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "x": 40,
      "y": 580
    },
    {
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
